{
  "name": "fretlab",
  "productName": "FRETLAB",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FRETLAB — Guitar Practice System",
  "author": "Aaron Visocnik",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "build:desktop": "cross-env FRETLAB_DESKTOP=1 vite build",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "gh-pages": "^6.3.0",
    "vite": "^6.0.0"
  }
}
